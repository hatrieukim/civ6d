civ6-mcp: tolerate rulesets without loyalty, Gathering Storm favor or eras
(scenarios such as Conquests of Alexander), so `brief` and city capture work there.
Applied by tools/setup on top of the pinned submodule commit.

diff --git a/src/civ_mcp/lua/cities.py b/src/civ_mcp/lua/cities.py
index ba3830b..b28e86e 100644
--- a/src/civ_mcp/lua/cities.py
+++ b/src/civ_mcp/lua/cities.py
@@ -128,7 +128,7 @@ for i, c in Players[me]:GetCities():Members() do
     end end
     table.insert(cityCoords, {name=nm, x=c:GetX(), y=c:GetY()})
     local loy, loyMax, loyPT, loyFlip = 100, 100, 0, 0
-    local cult = c:GetCulturalIdentity()
+    local cult = c.GetCulturalIdentity and c:GetCulturalIdentity()  -- nil without loyalty rules (scenarios)
     if cult then
         loy = cult:GetLoyalty()
         loyMax = cult:GetMaxLoyalty()
@@ -259,7 +259,8 @@ def build_resolve_city_capture(action: str) -> str:
     return f"""
 local me = Game.GetLocalPlayer()
 local player = Players[me]
-local city = player:GetCities():GetNextRebelledCity()
+local pc = player:GetCities()
+local city = pc.GetNextRebelledCity and pc:GetNextRebelledCity()  -- nil without loyalty rules (scenarios)
 local source = "rebelled"
 if city == nil then
     city = player:GetCities():GetNextCapturedCity()
